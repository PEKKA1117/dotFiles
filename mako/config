# ── 全域設定(必須在任何 [criteria] 之前)─────────────────────
max-history=100

# ── 外觀 ────────────────────────────────────────────────────
anchor=top-left
font=JetBrainsMono 12
background-color=#1a1b26
text-color=#c0caf5
width=500
height=500
margin=20,20,20
padding=10
border-size=2
border-color=#8478de
border-radius=5
progress-color=#8478de
output=HDMI-A-1

# ── 行為 ────────────────────────────────────────────────────
default-timeout=10000
group-by=app-name,summary
max-visible=5

# ── 群組摺疊 ────────────────────────────────────────────────
# mako 內建 [grouped] 已把同組通知設為 invisible、只留 group-index=0,
# 這裡只改版面字串,讓第一則顯示「(N)」計數。
[grouped]
format=(%g) <b>%s</b>\n%b

# 超過 max-visible 時顯示的佔位符
[hidden]
format=<i>還有 %h 則通知</i>

# ── 過濾:Vivaldi 的 Proton VPN 網頁推播只閃一下 ─────────────
# 注意:所有網頁推播的 app-name 都是 Vivaldi,所以必須用 summary~ 正規式
# 才不會把整個瀏覽器的通知一起降噪。
[app-name=Vivaldi summary~="^Proton VPN"]
default-timeout=1500
ignore-timeout=1

# ── urgency 樣式 ────────────────────────────────────────────
[urgency=low]
background-color=#1a1b26
text-color=#565f89
border-color=#414868

[urgency=critical]
background-color=#1a1b26
text-color=#f7768e
border-color=#f7768e
default-timeout=0

# ── 音量 OSD ────────────────────────────────────────────────
# 由 ~/.config/sway/scripts/volume_osd.sh 送出。
# icon-path 必填:mako 不讀 GTK 圖示主題,預設只找 hicolor 與 pixmaps,
# 兩邊都沒有 audio-volume-*;而 Tela-circle 全是 SVG,本機沒裝 gdk-pixbuf
# 的 SVG loader,mako 讀不了 —— 所以指向 AdwaitaLegacy 的 PNG。
[app-name=volume-osd]
output=DP-3
anchor=bottom-center
history=0
format=<b>%s</b>
font=JetBrainsMono 18
width=460
height=110
padding=18
outer-margin=0,0,100
border-radius=12
icon-path=/usr/share/icons/AdwaitaLegacy
max-icon-size=48

# 遊戲中(Steam reaper 存在)改送副螢幕。
# 只覆寫 output/anchor,其餘樣式沿用上面那條 criteria——後定義者勝。
# 理由:全螢幕遊戲會蓋掉 layer=top,OSD 留在 DP-3 等於看不見。
[app-name=volume-osd category=game]
output=HDMI-A-1
anchor=bottom-center
