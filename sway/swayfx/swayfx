# SwayFX config options

### Appearance
# window corner radius in px
corner_radius 4
# 暫時停用 smart_corner_radius:swayfx 0.5.3 的 container_has_corner_radius()
# 在全螢幕工作區開新視窗時會對 NULL workspace 解參照導致崩潰(上游 PR #483,
# 0.5.4 發布後可移除此行)
smart_corner_radius off

# Window background blur
blur enable
blur_xray disable
blur_passes 1
blur_radius 8
blur_noise 0
blur_brightness 1.0

shadows enable
shadows_on_csd off
shadow_blur_radius 8
shadow_color #0000007F

# Waybar blur
layer_effects "waybar" blur enable; shadows enable; corner_radius 10

# inactive window fade amount. 0.0 = no dimming, 1.0 = fully dimmed
default_dim_inactive 0.2
dim_inactive_colors.unfocused #000000FF
dim_inactive_colors.urgent #900000FF

# Move minimized windows into Scratchpad (enable|disable)
scratchpad_minimize enable
