#!/usr/bin/env bash
# 讓所有 Steam 遊戲自動吃到 gamemode,不必逐款加 gamemoderun 啟動選項
#
# ── 設計依據(2026-09-11 用 gamemode-probe 實測,非推測)────────────────
#
# 1. Steam 每啟動一款遊戲都會生一個 reaper,cmdline 帶 "SteamLaunch AppId=<n>",
#    它是整棵遊戲行程樹的祖先,並在場次結束時清掉所有子行程。辨識零歧義。
#
# 2. 有 gamemoderun 的遊戲:reaper 自己註冊(LD_PRELOAD 的 constructor 在 fork 前
#    就跑),整棵樹繼承 0-11。實測 Warframe:reaper gm=YES aff=0-11,
#    底下的 Warframe.x64.exe gm=no 卻也是 0-11 —— 純繼承,遊戲本體從沒註冊過。
#
# 3. 沒有 gamemoderun 的遊戲:reaper gm=no aff=0-19,整棵樹連同遊戲本體全是
#    0-19,gamemode 從頭到尾沒醒過。實測 Othercide(兩次)。
#
# 4. **只註冊 reaper 是不夠的**:gamemode 只釘註冊行程自己的所有執行緒,
#    對「已經生出來」的子行程無效(實測 parent 0-11 而先出生的 child 仍 0-19)。
#    而 reaper 到第一個子行程只差 13ms —— 任何輪詢都搶不贏。
#    所以註冊後必須再把整棵樹 taskset 一次;之後生出來的才會繼承。
#
# 5. 不要用執行檔路徑認遊戲:wine 遊戲的 exe 指向 compatibilitytools.d/GE-Proton...,
#    不在 steamapps/common 底下(Warframe.x64.exe、Othercide.exe 都是)。
#
# 用法:gamemode-autoregister              常駐
#       gamemode-autoregister --once --dry-run
# 停用:GMAR_OFF=1,或停掉 systemd unit

set -uo pipefail

LOG=/home/df/.local/share/gamemode-autoregister.log
POLL=${GMAR_POLL:-1}
# 輪詢間隔 1 秒就夠:我們不需要搶贏「reaper→第一個子行程」的 13ms,
# 因為註冊後會把整棵樹釘一次。真正的期限是「遊戲本體出現」,實測在 reaper
# 之後 10-14 秒,一秒一次綽綽有餘,CPU 開銷也接近零。
# 註冊後持續補釘的時間。遊戲本體約在 reaper 之後 10-14 秒才出現,
# 但只要它的祖先已被釘住就會繼承;這個視窗是防 fork 跟我們的樹遍歷擦身而過
PIN_WINDOW=${GMAR_PIN_WINDOW:-15}

# ── 雙開 / 掛機的例外清單(填 AppId)────────────────────────────────
# 兩款遊戲同時跑時,gamemode 會把兩者都釘在同一組 P-core 上互相搶。
# 如果其中一款是掛機/副帳,把它的 AppId 填進來:
#   SKIP_APPIDS  完全不碰(維持全核心 0-19,由排程器自行決定)
#   ECORE_APPIDS 反過來釘在 E-core,把 P-core 完整讓給主力遊戲
# 例:ECORE_APPIDS=(230410)  ← 掛機的 Warframe 丟去 E-core
SKIP_APPIDS=()
ECORE_APPIDS=()

source "$(dirname "$(readlink -f "$0")")/gamemode-cpu-topology.sh"

in_list() {  # $1=appid $2...=清單
    local want=$1; shift
    local x; for x in "$@"; do [[ "$x" == "$want" ]] && return 0; done
    return 1
}

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

# Steam 遊戲場次的錨點。
# 只比對 cmdline 會自我命中 —— 任何 cmdline 裡帶這串字的行程(包括本腳本自己、
# 或在 shell 裡打這個字串的指令)都會中。所以先用 exe 的檔名鎖定真正的 reaper,
# 再要求 AppId 後面確實接數字。
reaper_pids() {
    local pid comm exe cmd
    for pid in /proc/[0-9]*; do
        pid=${pid##*/}
        [[ "$pid" == "$$" ]] && continue
        # 先用 comm 粗篩,而且要用 $(< file) —— 那是 bash 內建讀檔,不 fork。
        # 原本每個 pid 都 fork readlink + tr,500 個行程 × 每秒 4 次 = 每秒兩千次
        # fork,光這個服務就吃掉 2/3 顆核心。粗篩後只剩極少數走昂貴路徑。
        comm=$(< "/proc/$pid/comm") 2>/dev/null || continue
        [[ "$comm" == reaper ]] || continue

        exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || continue
        [[ "${exe##*/}" == reaper ]] || continue
        # $(< file) 會把 cmdline 的 NUL 分隔符吃掉,變成參數黏在一起的字串
        # (…reaperSteamLaunchAppId=230410--…),所以用兩段 glob 而非精確比對
        cmd=$(< "/proc/$pid/cmdline") 2>/dev/null || continue
        [[ "$cmd" == *SteamLaunch*AppId=[0-9]* ]] && echo "$pid"
    done
}

appid_of() {
    grep -oE 'AppId=[0-9]+' <<< "$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null)" | head -1
}

# gamemoded -r 是 toggle,重複呼叫會把它反註冊掉 —— 一定要先查
registered() {
    [[ "$(gamemoded -s"$1" 2>/dev/null)" == *"[$1] registered"* ]]
}

pin_tree() {  # $1=樹根 pid  $2=核心遮罩
    local root=$1 cores=$2 p n=0
    while read -r p; do
        [[ -n "$p" ]] || continue
        taskset -acp "$cores" "$p" &>/dev/null && (( n++ ))
    done < <(proc_tree "$root")
    echo "$n"
}

DRY=0; ONCE=0
for a in "$@"; do
    case "$a" in
        --dry-run) DRY=1 ;;
        --once)    ONCE=1 ;;
        -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
        *) echo "未知參數:$a" >&2; exit 2 ;;
    esac
done

[[ "${GMAR_OFF:-0}" == 1 ]] && { echo "GMAR_OFF=1,已停用"; exit 0; }

detect_topology
[[ -n "${P_CORES:-}" ]] || { echo "偵測不到 P-core,結束" >&2; exit 1; }
[[ -n "${E_CORES:-}" ]] || { echo "同質 CPU,無隔離意義,結束" >&2; exit 0; }

declare -A HANDLED    # reaper pid -> 已處理
declare -A PINUNTIL   # reaper pid -> 補釘截止的 SECONDS
declare -A PINCORES   # reaper pid -> 這個場次該用的核心遮罩

log "啟動 P=$P_CORES E=$E_CORES 輪詢=${POLL}s 補釘視窗=${PIN_WINDOW}s"

while :; do
    while read -r rp; do
        [[ -n "$rp" ]] || continue
        if [[ -z "${HANDLED[$rp]:-}" ]]; then
            HANDLED[$rp]=1
            app=$(appid_of "$rp")
            id=${app#AppId=}

            if in_list "$id" ${SKIP_APPIDS+"${SKIP_APPIDS[@]}"}; then
                log "略過 pid=$rp $app(在 SKIP_APPIDS 清單)"
                continue
            fi

            if in_list "$id" ${ECORE_APPIDS+"${ECORE_APPIDS[@]}"}; then
                # 刻意不註冊 —— 一註冊 gamemode 就會把它拉上 P-core,
                # 與「讓出 P-core」的意圖相反。只把樹釘在 E-core 即可。
                if (( DRY )); then
                    echo "[dry-run] 會把 reaper pid=$rp $app 整棵樹釘到 E-core $E_CORES"
                else
                    n=$(pin_tree "$rp" "$E_CORES")
                    PINUNTIL[$rp]=$(( SECONDS + PIN_WINDOW ))
                    PINCORES[$rp]=$E_CORES
                    log "已把 pid=$rp $app 樹上 $n 個行程釘到 E-core(ECORE_APPIDS)"
                fi
                continue
            fi

            if registered "$rp"; then
                # 這款有 gamemoderun,自己註冊過了,不要再 toggle
                log "略過 pid=$rp $app(已由 gamemoderun 註冊)"
                continue
            fi
            if (( DRY )); then
                echo "[dry-run] 會註冊 reaper pid=$rp $app 並釘住整棵樹到 $P_CORES"
                continue
            fi
            if gamemoded -r"$rp" &>/dev/null; then
                n=$(pin_tree "$rp" "$P_CORES")
                PINUNTIL[$rp]=$(( SECONDS + PIN_WINDOW ))
                PINCORES[$rp]=$P_CORES
                log "已註冊 reaper pid=$rp $app,同時釘住樹上 $n 個行程到 $P_CORES"
            else
                log "註冊失敗 pid=$rp $app"
            fi
        elif [[ -n "${PINUNTIL[$rp]:-}" ]] && (( SECONDS < PINUNTIL[$rp] )); then
            pin_tree "$rp" "${PINCORES[$rp]}" >/dev/null
        fi
    done < <(reaper_pids)

    # 回收已結束的場次(gamemode 自己的 reaper thread 會註銷 client,不用我們管)
    for rp in "${!HANDLED[@]}"; do
        [[ -d /proc/$rp ]] && continue
        unset "HANDLED[$rp]" "PINUNTIL[$rp]" "PINCORES[$rp]"
    done

    (( ONCE )) && break
    sleep "$POLL"
done
