[Unit]
Description=Auto-register Steam games with GameMode (reaper anchor)
Documentation=file:///home/df/.config/gamemode/gamemodeScripts/gamemode-autoregister

[Service]
Type=simple
ExecStart=%h/.config/gamemode/gamemodeScripts/gamemode-autoregister
Restart=on-failure
RestartSec=5
# 自己就是背景服務,別跟遊戲搶排程
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=default.target
